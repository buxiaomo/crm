# Docker Hub mirror、首页、健康检查和指标入口；registry-mirrors 指向此 HTTPS 域名。
# CRM 默认 listen: "/run/crm.sock"；切换 TCP 模式时将上游改为 127.0.0.1:8888。
mirrors.example.com {
    log
    encode gzip
    @crawler {
        header_regexp crawler User-Agent "(?i)(bot|spider|crawler|scrapy)"
    }
    route {
        respond /robots.txt 200 {
            body <<ROBOTS
            User-agent: *
            Disallow: /
            ROBOTS
        }
        respond @crawler "Forbidden" 403
        reverse_proxy unix//run/crm.sock
    }
    tls {
        reuse_private_keys
    }
}
